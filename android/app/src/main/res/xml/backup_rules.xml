<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 11 (API 30) and below.
  Referenced by android:fullBackupContent in AndroidManifest.xml.

  The pre-API-31 counterpart to data_extraction_rules.xml. minSdk here is 26, so
  API 26 through 30 devices do honour this file, and without it those devices
  would still copy app-private health data into Google Drive.

  domain="root" is included even though the usual sample omits it: the WebView,
  which holds the zustand store in localStorage, keeps its state in app_webview/
  at the app root, outside files/ and shared_prefs/.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
