# Copy to .env and adjust for your machine. .env is gitignored.

# LLM provider via Cloudflare Worker proxy (same worker as Everbloom)
VITE_LLM_BASE_URL="https://everbloom-lyla-proxy.georgelanders2.workers.dev"
VITE_LLM_MODEL="big-pickle"

# Ollama fallback (local network)
VITE_OLLAMA_URL="http://127.0.0.1:11434"
VITE_OLLAMA_MODEL="smollm2:latest"

# OpenJarvis fallback (local, fast daemon)
VITE_JARVIS_URL="http://127.0.0.1:8000"
VITE_JARVIS_MODEL="nous-hermes2:latest"